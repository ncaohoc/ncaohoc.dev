---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import { published, byProjectOrder, projectCard } from '../../site';

const projects = published(await getCollection('projects')).sort(byProjectOrder);
---

<Base title="Dự án" description="Những dự án cá nhân mình đang làm và đã làm xong.">
  <div class="wrap">
    <header class="page-head">
      <h1>Dự án</h1>
      <p>Game, công cụ và hạ tầng mình tự dựng. Mỗi trang có tiến độ và những gì học được.</p>
    </header>
    <ProjectCards items={projects.map(projectCard)} />
  </div>
</Base>
