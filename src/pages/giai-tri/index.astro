---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { published } from '../../site';

const games = published(await getCollection('games'));
---

<Base title="Giải trí" description="Những game nhỏ mình tự làm, chơi ngay trên trình duyệt.">
  <div class="wrap">
    <header class="page-head">
      <h1>Giải trí</h1>
      <p>Những game nhỏ mình tự làm, chơi ngay trên trình duyệt, không cần cài đặt.</p>
    </header>
    <EntryList
      items={games.map((g) => ({
        href: `/giai-tri/${g.id}/`,
        title: g.data.title,
        description: g.data.description,
        date: g.data.date,
        tags: g.data.tags,
      }))}
      empty="Chưa có game nào. Sắp có."
    />
  </div>
</Base>
