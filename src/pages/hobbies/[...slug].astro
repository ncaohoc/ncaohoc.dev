---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { published } from '../../site';

export async function getStaticPaths() {
  const posts = published(await getCollection('hobbies'));
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const aside = [
  { label: 'Chủ đề', value: d.category },
  ...(d.gear.length ? [{ label: 'Dụng cụ', value: d.gear.join(', ') }] : []),
];
---

<Post
  title={d.title}
  description={d.description}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  aside={aside}
  cover={d.cover}
  back={{ href: '/hobbies/', label: 'Sở thích' }}
>
  <Content />
</Post>
