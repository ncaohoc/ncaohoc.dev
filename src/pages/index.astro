---
// Trang chủ dựng theo Taste Skill (.claude/skills/design-taste-frontend), bản thử trên nhánh redesign/taste-home.
// Trang này đứng riêng, không dùng Base.astro: header, footer và CSS lấy từ kit trong public/assets/
// (chép nguyên từ skill, không sửa tay). Các trang khác vẫn dùng giao diện cũ.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE, published, formatDate } from '../site';
import Seal from '../components/Seal.astro';

import posterSrc from '../assets/uploads/buc-man-sat.png';
import gpusSrc from '../assets/uploads/gpu-toggle-gpus.png';
import appsSrc from '../assets/uploads/gpu-toggle-apps.png';
import osdSrc from '../assets/uploads/gpu-toggle-osd.png';
import repairSrc from '../assets/uploads/gpu-toggle-repair.png';
import egpuSrc from '../assets/uploads/egpu-box-tren-ke.jpg';

const webp = (src: ImageMetadata, width: number) => getImage({ src, format: 'webp', width, quality: 82 });
const poster = await webp(posterSrc, 1200);
const share = await getImage({ src: posterSrc, format: 'jpg', width: 1200, quality: 88 });
const shots = {
  gpus: await webp(gpusSrc, 1000),
  apps: await webp(appsSrc, 1000),
  osd: await webp(osdSrc, 1000),
  repair: await webp(repairSrc, 1000),
};
const navShots = { gpus: await webp(gpusSrc, 640), poster: await webp(posterSrc, 640), egpu: await webp(egpuSrc, 640) };
const egpu = await webp(egpuSrc, 1100);

// Kiến thức: gom các trang Unity vào một thẻ, mỗi chủ đề khác một thẻ có icon thật của công cụ
const sheets = published(await getCollection('cheatsheets'));
const unitySheets = sheets.filter((s) => s.id.startsWith('unity-'));
const otherSheets = sheets.filter((s) => !s.id.startsWith('unity-'));
const ICONS: Record<string, { src: string; cls?: string; name: string }> = {
  unity: { src: '/assets/icons/unity.svg', cls: 'ic-ink', name: 'Unity' },
  blender: { src: '/assets/icons/blender.svg', name: 'Blender' },
  rust: { src: '/assets/icons/rust.svg', cls: 'ic-ink', name: 'Rust' },
  git: { src: '/assets/icons/git.svg', name: 'Git' },
  firebase: { src: '/assets/icons/firebase.svg', cls: 'ic-tall', name: 'Firebase' },
  'sql-sqlite': { src: '/assets/icons/file-sqlite.svg', name: 'SQLite' },
  web3: { src: '/assets/icons/ethereum.svg', cls: 'ic-tall', name: 'Ethereum' },
  'mang-may-tinh': { src: '/assets/icons/ui-network.svg', cls: 'ic-ink', name: 'Mạng máy tính' },
};

// Ghi chép mới: bài blog và bài sở thích, mới nhất lên trước
const writing = [
  ...published(await getCollection('blog')).map((p) => ({ href: `/blog/${p.id}/`, ...p.data })),
  ...published(await getCollection('hobbies')).map((h) => ({ href: `/hobbies/${h.id}/`, ...h.data })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);
const hobby = published(await getCollection('hobbies')).find((h) => h.id === 'hop-egpu-chong-bui');

// Nền x o: 34 ký hiệu rải khắp trang, cỡ từ nhỏ đến to, càng to càng mờ và nhoè
let seed = 1996;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const xo = Array.from({ length: 34 }, (_, i) => {
  const k = rnd();
  const size = Math.round(14 + k * k * 170);
  return {
    kind: i % 2 ? 'o' : 'x',
    accent: rnd() < 0.55,
    size,
    top: +(1 + rnd() * 97).toFixed(2),
    left: +(-4 + rnd() * 100).toFixed(2),
    op: +(0.16 - k * 0.11).toFixed(3),
    sw: +(2.4 - k * 1.2).toFixed(2),
    blur: +(k * k * 3).toFixed(1),
    t: Math.round(12 + rnd() * 14),
    dy: Math.round(-10 - rnd() * 18),
    r: Math.round(-12 + rnd() * 24),
    delay: Math.round(rnd() * 20),
  };
});

const title = `${SITE.name}: Unity game developer ở Sài Gòn`;
const description =
  'Blog của Nguyễn Lê Cao Học: game làm bằng Unity, GPU Toggle Tools cho eGPU và ghi chú kỹ thuật tra nhanh.';
const year = new Date().getFullYear();
const arrow =
  '<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>';
---

<!doctype html>
<html lang="vi" data-type="software" data-radius="soft" data-ground="sky" data-buttons="solid" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(share.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#06121f" />
    <meta name="site-kind" content="gaming" />
    <meta name="page-type" content="software" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,400..600&family=Geist+Mono:wght@400..500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@900&text=%E9%AB%98%E5%AD%B8&display=block"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <link rel="stylesheet" href="/assets/diagrams/diagram.css" />
    <!-- :root đúng như start.mjs brand in ra: màu mệnh Thủy chủ site chọn (nền xanh biển đêm, nhấn xanh nước), cặp font mona -->
    <style is:inline>
      :root {
        --p-bg: #06121f; --p-surface: #0c2036; --p-ink: #ffffff; --p-muted: #838a92;
        --p-accent: #5cc8ff; --p-accent-ink: #06121f; --p-action: #5cc8ff; --p-action-ink: #06121f;
        --p-inv-bg: #ffffff; --p-inv-surface: #ebeced; --p-inv-ink: #06121f; --p-inv-muted: #58626c;
        --p-inv-accent: #06121f; --p-inv-accent-ink: #ffffff; --p-inv-action: #06121f; --p-inv-action-ink: #ffffff;
        --font-display: "Mona Sans", system-ui, sans-serif;
        --font-text: "Mona Sans", system-ui, sans-serif;
        --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        --display-weight: 500;
        --display-tracking: -0.03em;
        --display-tracking-xl: -0.04em;
        --display-stretch: 104%;
        --ly-scale: 0.96;
      }
    </style>
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href="/assets/moments/moments.js" />
    <link rel="modulepreload" href="/assets/moments/lib.js" />
    <!-- CSS của trang: chỉ phần nằm trong hình và chiều cao panel của từng nhóm thẻ -->
    <style is:inline>
      .nav .menu-card .panel { --p-h: 200px; }
      #kien-thuc .panel { --p-h: 444px; }
      #kien-thuc .rows { margin: 0; padding: 0; list-style: none; }
      #kien-thuc .rows > li { padding-block: 0; }
      #kien-thuc .rows__name { display: flex; align-items: center; gap: var(--s-3); min-height: 37px; }
      #kien-thuc .rows__name .ic { flex: none; width: 20px; height: 20px; object-fit: contain; }
      @media (max-width: 639px) { #kien-thuc .rows__name { min-height: 44px; } #kien-thuc .panel { --p-h: 360px; } }
      /* Chủ site muốn bớt khoảng trống: section cao theo nội dung thay vì đúng một màn hình (luật của skill). */
      html main > section.section,
      html body > footer.footer.closing { height: auto; min-height: 0; --padt: 96px; --padb: 32px; }
      @media (max-width: 639px) {
        html main > section.section,
        html body > footer.footer.closing { --padt: 72px; --padb: 24px; }
      }
      /* Lời mời cuối trang: con dấu lớn, câu mời và nút trên một hàng */
      .close-row { align-items: center; justify-content: flex-start; gap: var(--s-6); }
      .close-row > div { flex: 1 1 320px; }
      .close-stamp { transform: rotate(-6deg); }
      html body > footer.footer.closing .closing__cta { margin-bottom: var(--s-8); }
      @media (max-width: 639px) { .close-stamp { height: 88px; width: auto; } }
      /* Hiện dần khi cuộn tới (src/lib/reveal.ts) */
      .rv-on [data-rv] { opacity: 0; transform: translateY(28px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); transition-delay: calc(var(--rv-i, 0) * 60ms); }
      .rv-on [data-rv].rv-in { opacity: 1; transform: none; }
      /* Nền x o mờ, nhiều cỡ, trôi chậm */
      body { position: relative; }
      .xo-ground { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
      .xo-ground svg { position: absolute; fill: none; stroke: currentColor; stroke-linecap: round; animation: xo-drift var(--xo-t) ease-in-out infinite alternate; }
      .xo-ground .xo-a { color: var(--p-accent); }
      .xo-ground .xo-i { color: var(--p-ink); }
      @keyframes xo-drift { from { transform: translateY(0) rotate(0deg); } to { transform: translateY(var(--xo-dy)) rotate(var(--xo-r)); } }
      @media (prefers-reduced-motion: reduce) { .xo-ground svg { animation: none; } }
      #ghi-chep .frame > img { object-position: 50% 78%; }
      /* Con dấu 高學 của site, đổi sang màu nhấn mệnh Thủy */
      :root { --seal: var(--p-accent); --seal-cut: var(--p-bg); }
      .nav__logo .seal { margin-right: var(--s-3); }
    </style>
  </head>
  <body>
    <div class="xo-ground" aria-hidden="true">
      {
        xo.map((g) => (
          <svg class={g.accent ? 'xo-a' : 'xo-i'} viewBox="0 0 24 24" width={g.size} height={g.size}
            style={`top:${g.top}%;left:${g.left}%;opacity:${g.op};stroke-width:${g.sw};filter:blur(${g.blur}px);--xo-t:${g.t}s;--xo-dy:${g.dy}px;--xo-r:${g.r}deg;animation-delay:-${g.delay}s`}>
            {g.kind === 'x' ? <path d="M5 5 19 19M19 5 5 19" /> : <circle cx="12" cy="12" r="8" />}
          </svg>
        ))
      }
    </div>
    <!-- type: software (site-kind gaming)
         deal: palette brand (mệnh Thủy, chủ site chọn, thay forest-pale-lime), hero film, nav nav-cards, close close-type with the site's seal (the owner found the big name empty), footer footer-dark, rhythm space (dealt again: media-band
         needs a landscape photograph other than the hero's, the site has none), buttons solid, mark dots, ground sky
         moments: none now (the owner asked for less scroll: pinned-chapters held a whole screen); #gpu-toggle is a peek-list
         logo: the site's own 高學 seal (src/components/Seal.astro) in the accent colour, not the dealt mark -->
    <header class="nav">
      <div class="wrap nav__bar">
        <a class="skip-link" href="#top">Bỏ qua menu</a>
        <a class="nav__logo" href="#top"><Seal size={34} id="nav" />{SITE.name}</a>
        <nav class="nav__links" aria-label="Menu chính">
          <div class="nav__item"><a class="nav__link" href="/blog/">Bài viết</a></div>
          <div class="nav__item"><a class="nav__link" href="/kien-thuc/">Kiến thức</a></div>
          <div class="nav__item">
            <a class="nav__link" href="/projects/"
              >Dự án <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"
                ><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                ></path></svg
              ></a
            >
            <div class="nav__menu">
              <div class="wrap grid">
                <a class="menu-card span-4" href="/projects/gpu-toggle-tools/">
                  <div class="panel"><img class="frame__img" src={navShots.gpus.src} alt="Trang GPUs của GPU Toggle Tools" loading="lazy" /></div>
                  <span class="t-card">GPU Toggle Tools</span>
                  <span class="t-small muted">Bật tắt GPU, đo PCIe, sửa lỗi Code 43</span>
                </a>
                <a class="menu-card span-4" href="/giai-tri/buc-man-sat/">
                  <div class="panel"><img class="frame__img" src={navShots.poster.src} alt="Xe tăng giữa các bức tường gạch trong Bức Màn Sắt" loading="lazy" /></div>
                  <span class="t-card">Bức Màn Sắt</span>
                  <span class="t-small muted">Game xe tăng 2.5D chơi trên trình duyệt</span>
                </a>
                <a class="menu-card span-4" href="/hobbies/hop-egpu-chong-bui/">
                  <div class="panel"><img class="frame__img" src={navShots.egpu.src} alt="Hộp mica chứa eGPU đặt dưới kệ ROG Ally" loading="lazy" /></div>
                  <span class="t-card">Hộp chống bụi cho eGPU</span>
                  <span class="t-small muted">Card có nhà riêng, quạt tự chỉnh theo nhiệt độ</span>
                </a>
              </div>
            </div>
          </div>
          <div class="nav__item"><a class="nav__link" href="/giai-tri/">Giải trí</a></div>
          <div class="nav__item"><a class="nav__link" href="/hobbies/">Sở thích</a></div>
        </nav>
        <div class="nav__actions">
          <a class="btn btn--primary" href="/cv/">Xem CV</a>
        </div>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Mở menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
            ><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg
          >
        </button>
      </div>
    </header>

    <main id="top">
      <!-- CLIENT FILE key art: ảnh chụp trong game Bức Màn Sắt (src/assets/uploads/buc-man-sat.png, 1200x627).
           Có ảnh chụp lớn hơn (1920x1080) thì thay vào đây. -->
      <section class="hero hero--film" data-enter aria-labelledby="hero-h">
        <div class="wrap">
          <div class="hero-text hero__in">
            <div class="hero__media hero__fill">
              <img
                src={poster.src}
                alt="Xe tăng T-55 và M48 giữa các bức tường gạch trong game Bức Màn Sắt"
                style="--ly-pos: 50% 40%; --ly-pos-phone: 30% 50%"
                fetchpriority="high"
                data-source="client"
                data-subject="Bức Màn Sắt, ảnh chụp trong game"
              />
              <div class="hero__over">
                <div>
                  <h1 id="hero-h">Nguyễn Lê Cao Học, Unity game developer</h1>
                  <p class="hero__lead">
                    Từng làm gameplay cho game fitness tại Aviron, giờ tự làm game riêng ở Sài Gòn. Bug vẫn còn, nhưng xe
                    tăng đã chạy được trên trình duyệt.
                  </p>
                  <div class="btn-row">
                    <a class="btn btn--primary" href="/cv/">Xem CV<Fragment set:html={arrow} /></a>
                  </div>
                </div>
                <a class="ly-play" href="/giai-tri/buc-man-sat/">
                  <span class="ly-play__disc"
                    ><svg viewBox="0 0 18 18" aria-hidden="true"
                      ><path d="M4.5 2.6v12.8c0 .8.9 1.3 1.6.9l10.3-6.4c.6-.4.6-1.3 0-1.7L6.1 1.7c-.7-.4-1.6.1-1.6.9Z" fill="currentColor"
                      ></path></svg
                    ></span
                  >
                  <span class="ly-play__label">Chơi Bức Màn Sắt<small>Xe tăng 2.5D, ra ngày 27/11/2026, không cần cài</small></span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- peek-list (system.js): rê chuột, focus hoặc chạm vào một dòng thì ảnh bên phải đổi theo -->
      <section class="section" id="gpu-toggle" aria-labelledby="gpu-h">
        <div class="wrap">
          <div class="section-head section-head--split" data-rv>
            <div>
              <h2 id="gpu-h">GPU Toggle Tools cho eGPU. <span class="muted">Cho những ai cắm eGPU xong game vẫn chạy iGPU.</span></h2>
            </div>
            <a class="link" href="/projects/gpu-toggle-tools/">Xem trang GPU Toggle Tools</a>
          </div>
          <div class="grid grid--top" data-peek>
            <ul class="rows span-6">
              <li data-peek-to="apps" tabindex="0" data-rv><span class="rows__name">Chọn GPU cho từng game</span><p>Bấm Launch to test để biết game chạy card nào, khỏi đoán qua tiếng quạt.</p></li>
              <li data-peek-to="osd" tabindex="0" data-rv><span class="rows__name">Xem FPS trong game kẹt ở đâu</span><p>OSD báo nghẽn ở GPU, CPU, PCIe hay VRAM. Đổ lỗi cho đúng linh kiện.</p></li>
              <li data-peek-to="repair" tabindex="0" data-rv><span class="rows__name">Sửa lỗi Code 43 của eGPU</span><p>Gỡ sạch driver NVIDIA hoặc AMD rồi sửa từ nhẹ đến mạnh, trước khi nghĩ tới chuyện bán card.</p></li>
            </ul>
            <div class="frame frame--photo span-6 start-7" data-rv style="--ratio: 60.2%">
              <img class="frame__img" data-peek-for="apps" src={shots.apps.src} alt="Trang Apps / Games: danh sách game và GPU được chọn cho từng game" width="1000" height="602" loading="lazy" data-source="client" data-subject="GPU Toggle Tools" />
              <img class="frame__img" data-peek-for="osd" src={shots.osd.src} alt="Trang OSD: FPS, GPU, VRAM, CPU, RAM và băng thông PCIe" width="1000" height="602" loading="lazy" data-source="client" data-subject="GPU Toggle Tools" hidden />
              <img class="frame__img" data-peek-for="repair" src={shots.repair.src} alt="Trang Repair: các bước gỡ driver và sửa lỗi Code 43" width="1000" height="602" loading="lazy" data-source="client" data-subject="GPU Toggle Tools" hidden />
            </div>
          </div>
        </div>
      </section>

      <section class="section ic-dark" id="kien-thuc" aria-labelledby="kt-h">
        <div class="wrap">
          <div class="section-head section-head--split" data-rv>
            <div>
              <h2 id="kt-h">Ghi chú kỹ thuật tra nhanh. <span class="muted">{sheets.length} trang, đọc trước khi hỏi AI.</span></h2>
            </div>
            <a class="link" href="/kien-thuc/">Xem tất cả ghi chú</a>
          </div>
          <div class="grid grid--top">
            <div class="panel span-6" data-rv><div class="dg" data-diagram><script type="application/json">{"layout": "hub", "alt": "Các ghi chú toả ra từ một mục: Unity với DOTS và shader, cùng Blender, Git, Firebase, SQLite và Web3.", "center": {"label": "Ghi chú", "icon": "ui:book-open"}, "spokes": [{"label": "Unity", "icon": "unity", "children": [{"label": "DOTS", "icon": "ui:file-code"}, {"label": "Shader", "icon": "ui:file-code"}]}, {"label": "Blender", "icon": "blender"}, {"label": "Git", "icon": "git"}, {"label": "Firebase", "icon": "firebase"}, {"label": "SQLite", "icon": "file:sqlite"}, {"label": "Web3", "icon": "ethereum"}]}</script></div></div>
            <ul class="rows span-6 start-7">
              {
                [...unitySheets, ...otherSheets].map((s) => {
                  const ic = s.id.startsWith('unity-') ? ICONS.unity : ICONS[s.id];
                  return (
                    <li data-rv>
                      <a class="rows__name" href={`/kien-thuc/${s.id}/`}>
                        {ic && <img class={`ic ic-24 ${ic.cls ?? ''}`} src={ic.src} alt="" width="24" height="24" />}
                        {s.data.title}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="ghi-chep" aria-labelledby="gc-h">
        <div class="wrap">
          <div class="section-head" data-rv>
            <h2 id="gc-h">{writing.length} bài viết mới nhất</h2>
            <p>Devlog, chuyện nghề và đồ tự chế chưa cháy lần nào.</p>
          </div>
          <div class="grid grid--top">
            <ul class="rows span-6">
              {
                writing.map((w) => (
                  <li data-rv>
                    <a class="rows__name link" href={w.href}>{w.title}</a>
                    <span class="rows__value">{formatDate(w.date)}</span>
                  </li>
                ))
              }
            </ul>
            {
              hobby && (
                <a class="frame frame--photo span-6 start-7" data-rv href={`/hobbies/${hobby.id}/`} style="--ratio: 75%">
                  <img
                    class="frame__img"
                    src={egpu.src}
