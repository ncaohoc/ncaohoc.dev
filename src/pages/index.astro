    <script>
      // Menu điện thoại của kit mở bằng class .is-open: khoá phần bên dưới bằng helper dùng chung
      import { lockWhileClass } from '../lib/lock-under';
      import { revealOnScroll } from '../lib/reveal';
      revealOnScroll();
      const nav = document.querySelector('header.nav');
