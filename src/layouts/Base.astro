---
import '../styles/global.css';
import Seal from '../components/Seal.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, NAV, published } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: ImageMetadata; // ảnh og:image khi chia sẻ link
}
const { title, description = SITE.description, type = 'website', image } = Astro.props;
// LinkedIn không nhận WebP, nên xuất ảnh chia sẻ ra JPG rộng tối đa 1200px
const og = image && (await getImage({ src: image, format: 'jpg', quality: 88, width: Math.min(image.width, 1200) }));
const ogUrl = og && new URL(og.src, Astro.site);
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();

// Ẩn mục "Sở thích" khỏi menu khi chưa có bài hoặc album nào đã đăng, "Giải trí" khi chưa có game nào
const hobbyCount =
  published(await getCollection('hobbies')).length + published(await getCollection('albums')).length;
const gameCount = published(await getCollection('games')).length;
const nav = NAV.filter(
  (item) => (item.href !== '/hobbies/' || hobbyCount > 0) && (item.href !== '/giai-tri/' || gameCount > 0),
);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    {
      og && ogUrl && (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content={String(og.attributes.width ?? '')} />
          <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogUrl} />
        </>
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
    />
    <!-- Chỉ tải đúng 2 chữ của con dấu, không tải cả bộ font CJK -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@900&text=%E9%AB%98%E5%AD%B8&display=block"
    />

    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Bỏ qua tới nội dung</a>
    <header class="site-header">
      <div class="header-inner">
      <a href="/" class="brand" aria-label="Trang chủ">
        <Seal size={44} id="header" />
        <span class="brand-name">{SITE.name}</span>
      </a>
      <nav id="site-menu" aria-label="Chính">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-label="Đổi giao diện sáng/tối">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path class="sun" d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
            <path class="moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
          </svg>
        </button>
        <a class="cv-btn" href="/cv/" aria-current={path.startsWith('/cv/') ? 'page' : undefined}>Xem CV</a>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Mở menu">
        <svg class="bars" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" /></svg>
        <svg class="cross" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" /></svg>
      </button>
      </div>
    </header>

    <canvas class="xo-3d" aria-hidden="true"></canvas>
    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>© {year} {SITE.fullName}. Viết ở Sài Gòn.</p>
      <ul>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/cv/">CV</a></li>
      </ul>
    </footer>

    <script>
      // Menu dưới 1024px, giống trang chủ: nút ☰ mở sheet toàn màn hình.
      // Khi sheet mở, phần dưới bị khoá bằng helper dùng chung (inert); Esc, nút ✕ hay bấm một mục thì đóng,
      // và focus trở về nút menu.
      import { lockUnder } from '../lib/lock-under';
      const header = document.querySelector<HTMLElement>('.site-header');
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      let unlock: (() => void) | null = null;
      const setMenu = (open: boolean, returnFocus = true) => {
        if (!header || !menuBtn || open === header.classList.contains('is-open')) return;
        header.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
        if (open) unlock = lockUnder(header);
        else {
          unlock?.();
          unlock = null;
          if (returnFocus) menuBtn.focus();
        }
      };
      menuBtn?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header?.classList.contains('is-open')) {
          e.preventDefault();
          setMenu(false);
        }
      });
      header?.querySelector('#site-menu')?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a[href]')) setMenu(false, false);
      });
      matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setMenu(false, false));
    </script>
    <script>
      // Nền x o 3D (src/lib/xo-3d.ts), thưa và mờ hơn trang chủ vì đây là trang đọc.
      // three.js chỉ tải khi trình duyệt rảnh, sau khi trang đã hiện.
      const xoCanvas = document.querySelector<HTMLCanvasElement>('canvas.xo-3d');
      const startXo = () =>
        import('../lib/xo-3d')
          .then(({ startXo3d }) => (xoCanvas ? startXo3d(xoCanvas, { opacity: 0.14, middleGap: 0.6 }) : false))
          .then((ok) => ok && document.documentElement.classList.add('xo3d'));
      if ('requestIdleCallback' in window) requestIdleCallback(startXo, { timeout: 2500 });
      else setTimeout(startXo, 1000);
    </script>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--paper);
    z-index: 10;
  }
  /* Header giống trang chủ (kit Taste Skill): nền đặc, đường kẻ dưới, rộng 1280px với lề 80px,
     logo và menu bên trái, nút "Xem CV" và nút sáng/tối bên phải */
  .site-header {
    --hgut: 80px;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem 64px;
    width: min(100% - 2 * var(--hgut), 1280px);
    margin-inline: auto;
    min-height: 71px; /* cộng đường kẻ 1px là 72px, bằng trang chủ */
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-name {
    font: 500 22px/1 var(--mono);
    letter-spacing: -0.02em;
  }
  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    font: 500 15px/1 var(--mono);
    white-space: nowrap;
  }
  /* gạch chân vẽ ra khi rê chuột; trang đang mở giữ vạch 2px màu nhấn */
  nav a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  nav a[aria-current='page'] {
    color: var(--seal);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.5rem;
    border: 1px solid transparent; /* như nút của kit, để rộng bằng nút trang chủ */
    border-radius: 8px;
    background: var(--seal);
    color: var(--seal-cut);
    font: 500 15px/1 var(--mono);
    text-decoration: none;
    transition: transform 0.2s var(--ease), filter 0.2s;
  }
  .cv-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .cv-btn:active {
    transform: scale(0.97);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.3s var(--ease);
  }
  .theme-toggle:hover {
    background: var(--surface);
    transform: rotate(15deg);
  }
  .theme-toggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 5rem;
    padding-block: 2rem 3rem;
    background: linear-gradient(var(--rule), var(--rule)) no-repeat var(--gutter) 0 / calc(100% - 2 * var(--gutter)) 1px;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer a {
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .site-header {
      --hgut: 48px;
    }
  }
  .menu-toggle {
    display: none;
  }
  /* Dưới 1024px: giống trang chủ. Thanh trên: logo, "Xem CV", nút ☰.
     Bấm ☰ mở sheet toàn màn hình: các mục cao 56px, dưới cùng là nút sáng/tối và "Xem CV" rộng hết hàng. */
  @media (max-width: 1023px) {
    .header-inner {
      gap: 0.75rem;
    }
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .menu-toggle path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
    }
    .menu-toggle .cross,
    .is-open .menu-toggle .bars {
      display: none;
    }
    .is-open .menu-toggle .cross {
      display: block;
    }
    /* cụm nút xuống đáy sheet thì nút ✕ tự đẩy sang góc phải */
    .is-open .menu-toggle {
      margin-left: auto;
    }
    .header-actions {
      gap: 0.5rem;
    }
    .site-header:not(.is-open) .theme-toggle {
      display: none;
    }
    nav {
      display: none;
    }
    .is-open nav {
      display: block;
      position: fixed;
      inset: var(--bar-h, 72px) 0 0;
      padding: 16px var(--hgut) 10rem;
      overflow-y: auto;
      background: var(--paper);
    }
    .is-open nav ul {
      flex-direction: column;
      gap: 0;
    }
    .is-open nav a {
      height: auto;
      min-height: 57px; /* 56px cộng đường kẻ, như trang chủ */
      padding: 0;
      border-radius: 0;
      font-size: 20px;
      border-bottom: 1px solid var(--rule);
    }
    .is-open nav a::after {
      display: none;
    }
    .is-open .header-actions {
      position: fixed;
      left: var(--hgut);
      right: var(--hgut);
      bottom: max(16px, env(safe-area-inset-bottom));
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding-top: 1rem;
      border-top: 1px solid var(--rule);
      background: var(--paper);
    }
    .is-open .theme-toggle {
      align-self: flex-start;
    }
    .is-open .cv-btn {
      justify-content: center;
      height: 48px;
    }
  }
  @media (max-width: 640px) {
    .site-header {
      --hgut: 24px;
      --bar-h: 56px;
    }
    .header-inner {
      min-height: 55px;
    }
    .brand :global(.seal) {
      height: 36px;
      width: auto;
    }
    .brand-name {
      font-size: 20px;
    }
    .header-inner {
      gap: 8px;
    }
    .header-actions {
      gap: 8px;
    }
    .cv-btn {
      padding: 0 12px;
      font-size: 14px;
    }
    .is-open .cv-btn {
      font-size: 15px;
    }
    .site-footer {
      margin-top: 3.5rem;
    }
    .site-footer a {
      display: inline-block;
      padding-block: 0.4rem;
    }
  }
</style>
