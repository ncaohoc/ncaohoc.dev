---
import Base from './Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../site';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  back: { href: string; label: string };
  wide?: boolean; // cheatsheet dùng bố cục nhiều cột
  aside?: { label: string; value: string; href?: string }[];
  cover?: ImageMetadata;
}
const { title, description, date, updated, tags = [], back, wide = false, aside = [], cover } = Astro.props;
---

<Base title={title} description={description} type="article">
  <article class="wrap">
    <header class="post-head">
      <a class="back" href={back.href}>{back.label}</a>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Cập nhật {formatDate(updated)}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Thẻ">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        )
      }
      {
        aside.length > 0 && (
          <dl class="facts">
            {aside.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>
    {
      cover && (
        <figure class="cover">
          <Image src={cover} alt="" widths={cover.width > 800 ? [800, 1400, 2000].filter((w) => w <= cover.width) : [cover.width]} sizes="(max-width: 1100px) 100vw, 1060px" format="webp" />
        </figure>
      )
    }
    <div class:list={['prose', { sheet: wide }]}>
      <slot />
    </div>
  </article>
</Base>

<style>
  .post-head {
    padding-block: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .back::before {
    content: '‹ ';
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    font-size: var(--step-3);
    font-weight: 800;
    max-width: 22ch;
    text-wrap: balance;
  }
  .desc {
    margin: 0.9rem 0 0;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--measure);
    line-height: 1.5;
  }
  .meta {
    display: flex;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .cover {
    margin: -0.5rem 0 3rem;
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: cover;
    border-radius: 4px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.75rem 0 0;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  /* Cheatsheet: chia cột theo từng mục h2 */
  .sheet {
    max-width: none;
    columns: 2 26rem;
    column-gap: 3rem;
  }
  .sheet :global(h2) {
    break-after: avoid;
    font-size: var(--step-1);
    margin-top: 0;
    padding-top: 1.75rem;
    border-top: 2px solid var(--ink);
  }
  .sheet :global(h2:first-child) {
    padding-top: 0.75rem;
  }
  .sheet :global(pre),
  .sheet :global(table),
  .sheet :global(li) {
    break-inside: avoid;
  }
  .sheet > :global(*) {
    margin-top: 0.75rem;
  }
  .sheet :global(table) {
    display: table;
  }
</style>
