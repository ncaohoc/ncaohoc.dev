---
import Base from './Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../site';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  back: { href: string; label: string };
  wide?: boolean; // cheatsheet: bố cục rộng + mục lục bên trái
  aside?: { label: string; value: string; href?: string }[];
  cover?: ImageMetadata;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, date, updated, tags = [], back, wide = false, aside = [], cover, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} type="article">
  <article class="wrap">
    <header class="post-head">
      <a class="back" href={back.href}>{back.label}</a>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Cập nhật {formatDate(updated)}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Thẻ">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        )
      }
      {
        aside.length > 0 && (
          <dl class="facts">
            {aside.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>
    {
      cover && (
        <figure class="cover">
          <Image src={cover} alt="" widths={cover.width > 800 ? [800, 1400, 2000].filter((w) => w <= cover.width) : [cover.width]} sizes="(max-width: 1100px) 100vw, 1060px" format="webp" />
        </figure>
      )
    }
    {
      wide && toc.length > 2 ? (
        <div class="sheet-layout">
          <nav class="toc" aria-label="Mục lục" data-toc>
            <p>Mục lục</p>
            <ol>
              <span class="toc-marker" aria-hidden="true"></span>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-slug={h.slug}>{h.text.replace(/^\d+(\.\d+)*\.?\s+/, '')}</a>
                </li>
              ))}
            </ol>
          </nav>
          <div class="prose sheet">
            <slot />
          </div>
        </div>
      ) : (
        <div class:list={['prose', { sheet: wide }]}>
          <slot />
        </div>
      )
    }
  </article>
</Base>

<script>
  // Mục lục chạy theo: đánh dấu mục h2 đang đọc, vạch đỏ trượt theo.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]'));
    const marker = toc.querySelector<HTMLElement>('.toc-marker')!;
    const sections = links
      .map((a) => document.getElementById(a.dataset.slug!))
      .filter((el): el is HTMLElement => !!el);
    let current = -1;

    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      links.forEach((a, j) => a.toggleAttribute('aria-current', j === i));
      const a = links[i];
      if (!a) {
        marker.style.opacity = '0';
        return;
      }
      marker.style.opacity = '1';
      marker.style.transform = `translateY(${a.offsetTop}px)`;
      marker.style.height = `${a.offsetHeight}px`;
      // giữ mục đang đọc luôn trong khung khi mục lục dài hơn màn hình
      const box = toc.getBoundingClientRect();
      const r = a.getBoundingClientRect();
      if (r.top < box.top + 40 || r.bottom > box.bottom - 40) {
        toc.scrollTo({ top: a.offsetTop - toc.clientHeight / 3, behavior: 'smooth' });
      }
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.3;
      let idx = -1;
      for (let i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= line) idx = i;
        else break;
      }
      // cuộn tới cuối trang thì chọn mục cuối
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        idx = sections.length - 1;
      }
      setActive(idx);
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      const i = current;
      current = -1;
      setActive(i);
    });
    update();
  }
</script>

<style>
  .post-head {
    padding-block: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .back::before {
    content: '‹ ';
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    font-size: var(--step-3);
    font-weight: 800;
    max-width: 22ch;
    text-wrap: balance;
  }
  .desc {
    margin: 0.9rem 0 0;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--measure);
    line-height: 1.5;
  }
  .meta {
    display: flex;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .cover {
    margin: -0.5rem 0 3rem;
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: cover;
    border-radius: 4px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.75rem 0 0;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  /* Cheatsheet: nội dung rộng hơn, mục lục dính bên trái trên màn hình lớn */
  .sheet-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .toc {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    font-size: var(--step--1);
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }
  .toc ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    border-left: 1px solid var(--rule);
  }
  .toc-marker {
    position: absolute;
    top: 0;
    left: -1px;
    width: 2px;
    height: 0;
    background: var(--seal);
    border-radius: 2px;
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.3, 0.7, 0.3, 1),
      height 0.3s cubic-bezier(0.3, 0.7, 0.3, 1),
      opacity 0.2s;
    pointer-events: none;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: flex;
    gap: 0.5rem;
    padding: 0.3rem 0 0.3rem 0.85rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
  }
  .toc a::before {
    content: counter(toc);
    min-width: 1.1rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
  .toc a {
    transition: color 0.2s;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }
  .toc a[aria-current]::before {
    color: var(--seal);
    opacity: 1;
  }
  .sheet {
    max-width: 52rem;
  }
  .sheet :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.75em;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
    scroll-margin-top: 1rem;
  }
  .sheet :global(h2:first-child) {
    margin-top: 0;
  }
  .sheet :global(h3) {
    scroll-margin-top: 1rem;
  }
  .sheet :global(td code),
  .sheet :global(th code) {
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .sheet-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .toc {
      position: static;
      max-height: none;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule);
    }
    .toc ol {
      columns: 2 12rem;
    }
    .toc-marker {
      display: none;
    }
  }
</style>
