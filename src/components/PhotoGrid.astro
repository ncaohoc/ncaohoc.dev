---
// Lưới ảnh kiểu masonry + xem ảnh lớn khi bấm vào.
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../lib/albums';

interface Props {
  photos: Photo[];
  id: string;
  alt?: string; // mô tả chung khi ảnh không có chú thích
}
const { photos, id, alt = 'Ảnh trong album' } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({ src: p.img, width: Math.min(2000, p.img.width), format: 'webp' });
    return { ...p, full: full.src };
  }),
);
---

<div class="photos" data-gallery={id}>
  <ul class="grid">
    {
      items.map((p) => (
        <li>
          <button type="button" class="open" data-full={p.full} data-caption={p.caption}>
            <Image
              src={p.img}
              alt={p.caption || alt}
              widths={p.img.width > 400 ? [400, 700, 1000].filter((w) => w <= p.img.width) : [p.img.width]}
              sizes="(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 360px"
              loading="lazy"
              format="webp"
            />
          </button>
          {p.caption && <p class="cap">{p.caption}</p>}
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox">
    <form method="dialog">
      <button class="close" aria-label="Đóng">×</button>
    </form>
    <img alt="" />
    <p class="lb-cap"></p>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector('dialog')!;
    const big = dialog.querySelector('img')!;
    const cap = dialog.querySelector('.lb-cap')!;

    root.querySelectorAll<HTMLButtonElement>('.open').forEach((btn) => {
      btn.addEventListener('click', () => {
        big.src = btn.dataset.full ?? '';
        big.alt = btn.querySelector('img')?.alt ?? '';
        cap.textContent = btn.dataset.caption ?? '';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

  });
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 16rem;
    column-gap: 1rem;
  }
  .grid li {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }
  .grid li[hidden] {
    display: none;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--rule);
    cursor: zoom-in;
    border-radius: 3px;
    overflow: hidden;
  }
  .open img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s;
  }
  .open:hover img {
    opacity: 0.88;
  }
  .cap {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .grid {
      columns: 2;
      column-gap: 0.6rem;
    }
    .cap {
      display: none;
    }
  }

  .lightbox {
    max-width: min(96vw, 1400px);
    max-height: 96vh;
    padding: 0;
    border: 0;
    background: transparent;
    color: #eee;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(8 10 12 / 0.92);
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    margin-inline: auto;
  }
  .lb-cap {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: var(--step--1);
    color: #b9c0c7;
  }
  .close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #444;
    border-radius: 50%;
    background: #111;
    color: #eee;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
