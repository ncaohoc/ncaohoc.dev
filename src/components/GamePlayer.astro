---
// Khung chơi game WebGL. Game chỉ được tải khi bấm "Bắt đầu chơi" để trang mở nhanh,
// sau đó nạp vào iframe và chuyển focus vào game. Nút toàn màn hình phóng cả khung.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // đường dẫn index.html của bản build
  title: string;
  aspect?: string; // CSS aspect-ratio, vd. '16 / 9'
  controls?: string;
  cover?: ImageMetadata;
}
const { src, title, aspect = '16 / 9', controls, cover } = Astro.props;
// Tỉ lệ dạng số để tính bề rộng khung theo chiều cao màn hình
const [aw, ah = 1] = aspect.split('/').map((n) => parseFloat(n));
const ratio = aw / ah || 16 / 9;
---

<section class="player" id="choi" style={`--ratio: ${ratio}`} aria-label={`Chơi ${title}`} data-player data-src={src} data-title={title}>
  <div class="frame" style={`aspect-ratio: ${aspect}`} data-frame>
    {cover && <Image class="poster" src={cover} alt="" widths={[800, 1400]} sizes="100vw" format="webp" />}
    <div class="start" data-start>
      <button class="btn" type="button" data-play>Bắt đầu chơi</button>
      {controls && <p>{controls}</p>}
      <p class="touch-note">Game cần bàn phím và chuột, nên chơi trên máy tính.</p>
    </div>
  </div>
  <div class="bar">
    <p class="hint">Bấm vào khung game để điều khiển. Esc để tạm dừng.</p>
    <button class="btn btn-ghost" type="button" data-full disabled>Toàn màn hình</button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const frame = player.querySelector<HTMLElement>('[data-frame]')!;
    const start = player.querySelector<HTMLElement>('[data-start]')!;
    const play = player.querySelector<HTMLButtonElement>('[data-play]')!;
    const full = player.querySelector<HTMLButtonElement>('[data-full]')!;
    let iframe: HTMLIFrameElement | null = null;

    play.addEventListener('click', () => {
      if (iframe) return;
      iframe = document.createElement('iframe');
      iframe.src = player.dataset.src!;
      iframe.title = player.dataset.title!;
      iframe.allow = 'fullscreen; autoplay; gamepad';
      iframe.setAttribute('allowfullscreen', '');
      frame.append(iframe);
      // Bỏ lớp nút "Bắt đầu chơi" để một lần bấm chỉ tác động một lớp, rồi đưa focus vào game
      start.remove();
      frame.querySelector('.poster')?.remove();
      full.disabled = false;
      iframe.addEventListener('load', () => iframe?.focus());
      iframe.focus();
      // Cuộn để cả khung game nằm gọn trong màn hình
      player.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    full.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else frame.requestFullscreen?.().then(() => iframe?.focus());
    });
    document.addEventListener('fullscreenchange', () => {
      const on = document.fullscreenElement === frame;
      full.textContent = on ? 'Thoát toàn màn hình' : 'Toàn màn hình';
      // Thoát toàn màn hình thì focus về lại game
      if (!on) iframe?.focus();
    });
  });
</script>

<style>
  /* Khung rộng hơn cột bài viết: lớn nhất có thể mà vẫn vừa chiều cao cửa sổ
     (trừ thanh menu và thanh nút bên dưới), không bao giờ hẹp hơn cột.
     Trừ thêm 1.25rem cho thanh cuộn dọc để không sinh cuộn ngang. */
  .player {
    --w: max(100%, min(calc(100vw - 2 * var(--gutter) - 1.25rem), calc((100svh - var(--header-h) - 5rem) * var(--ratio))));
    width: var(--w);
    margin: 0 calc((100% - var(--w)) / 2) 2.5rem;
    scroll-margin-top: calc(var(--header-h) + 0.5rem);
  }
  .frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--code-bg);
  }
  .frame:fullscreen {
    border: 0;
    border-radius: 0;
    background: var(--ink);
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.7);
  }
  .start {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    text-align: center;
  }
  .start p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
  }
  /* Chữ nằm trên ảnh bìa đã làm tối nên luôn dùng màu sáng */
  .poster + .start p {
    color: var(--seal-cut);
  }
  .touch-note {
    display: none;
  }
  @media (pointer: coarse) {
    .touch-note {
      display: block;
    }
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }
  .hint {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .bar .btn[disabled] {
    opacity: 0.45;
    pointer-events: none;
  }
</style>
