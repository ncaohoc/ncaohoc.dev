---
// Lưới card dự án. Dự án `featured` chiếm cả hàng và có nút tới repo.
interface Item {
  href: string;
  title: string;
  description: string;
  status: string;
  stack: string[];
  repo?: string;
  download?: string;
  version?: string;
  featured?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="empty">Chưa có dự án nào. Sắp có.</p>
  ) : (
    <ul class="cards project-cards">
      {items.map((p) => (
        <li class:list={['card', { featured: p.featured }]}>
          <div class="top">
            <span class="meta status" data-status={p.status}>{p.status}</span>
            {p.featured && <span class="pill">Nổi bật</span>}
          </div>
          <h3>
            <a class="card-link" href={p.href}>{p.title}</a>
          </h3>
          <p class="desc">{p.description}</p>
          {p.stack.length > 0 && (
            <ul class="tags" aria-label="Công nghệ">
              {p.stack.map((t) => <li>{t}</li>)}
            </ul>
          )}
          {p.featured && (p.download || p.repo) && (
            <p class="actions">
              {p.download && (
                <a class="btn" href={p.download}>
                  {p.version ? `Tải về v${p.version}` : 'Tải về'}
                </a>
              )}
              {p.repo && (
                <a class="btn btn-ghost" href={p.repo}>
                  Mã nguồn trên GitHub
                </a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .empty {
    color: var(--muted);
    margin: 0;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  h3 {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .card:hover .card-link {
    color: var(--jade);
  }
  .desc {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .tags {
    margin-top: 0.25rem;
  }
  .featured {
    grid-column: 1 / -1;
    padding: 1.6rem 1.75rem 1.75rem;
    background:
      radial-gradient(120% 140% at 100% 0%, var(--jade-soft), transparent 55%),
      var(--surface);
  }
  .featured h3 {
    font-size: var(--step-2);
  }
  .featured .desc {
    max-width: var(--measure);
    font-size: 1.05em;
  }
  /* Nút repo nằm trên lớp link phủ cả card */
  .actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
  }
</style>
